    "appliesTo": "EVERY_CONSEQUENTIAL_GOVERNED_OPERATION_AT_ANY_WORKER_MODEL_TOOL_DEVICE_HANDOFF_OR_RELEASE_GATE",
    "preconditions": [
      "controllingLawsAndJurisdiction",
      "policiesAndProcedures",
      "missionWorkAndOwner",
      "authorizedScopeAndGrant",
      "evidenceAndTraceReferences",
      "measurementAcceptanceBaseline",
      "decisionOwnerAndCriteria",
      "rollbackAndRecovery",
      "skillAndTeachingObjectiveWhenApplicable"
    ],
    "runtimeEvidence": [
      "operationAndCorrelationIdentity",
      "selectedSkillsAndAuthorizedTools",
      "actualInputsOutputsAndMeasuredEffects",
      "evidenceForAndAgainst",
      "incrementalNotesAndReferenceLinks",
      "denialsOrBlockers",
      "sourceAndAuthorityVersion"
    ],
    "outcomeRequirements": [
      "independentDecisionWhenRequired",
      "originalReceiptAndContinuumReadbackWhenEligible",
      "eligibleLearningAdmissionOrExplicitNotAdmitted",
      "correctionRetestAndOriginalMissionResumption",
      "learnerPracticeAndIndependentTeachBackWhenApplicable",
      "productionStatusDistinctFromCodeAndCi"
    ],
    "nonApplicableFieldHandling": "DOCUMENT_NA_REASON",
    "missingMandatoryFieldHandling": "BLOCK_DEPENDENT_OPERATION_NOT_ALL_UNRELATED_WORK",
    "disallowed": [
      "SELF_GRANTED_AUTHORITY",
      "SELF_ISSUED_VERITAS_OR_BADGE",
      "INVENTED_EVIDENCE",
      "DUPLICATE_LEDGER_OR_QUEUE",
      "FALSE_PRODUCTION_CLAIM"
    ]
  }
