  "closingRule": "NO_COMPLETION_WITHOUT_TASK_ACCEPTANCE",
  "releaseRule": "NO_SK_WHILE_C3_OPEN",
  "githubFirstRule": {
    "before": "Recover checkpoint; inspect canonical GitHub source, branch, implementation, contracts, hashes and evidence; classify reuse status.",
    "after": "Reconcile GitHub commit, PR, CI, source identity and acceptance; independently qualify runtime execution.",
    "sourceAuthority": "GITHUB_VERSIONED_SOURCE_AND_RELEASE",
    "executionAuthority": "AUTHORIZED_RUNTIME_AND_VERITAS",
    "noFixedHostIdentity": true
  },
  "operationDefinitionContract": {
    "status": "REVIEW_REQUIRED_NOT_RUNTIME_ENFORCED",
    "lawReferences": [
