{
  "schemaVersion": "leeway.engineering.permanent-rules.v1",
  "authority": "4citeB4U/LeeWay-Standards",
  "mission": "Golden Package C3: repair always returns to original gate",
  "ruleCount": 25,
  "ruleIds": [
    "R01",
    "R02",
    "R03",
    "R04",
    "R05",
