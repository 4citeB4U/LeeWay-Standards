{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4citeb4u.github.io/LeeWay-Standards/contracts/leeway-application-manifest.v1.schema.json",
  "title": "LeeWay Application Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "applicationId",
    "repository",
    "authorityRole",
    "capabilities",
    "dependencies",
    "surfaces",
    "runtimeBindings",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "required": [
        "fullName"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "approvedCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "commitPolicy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SELF_COMMIT_RESOLVED_AT_CONSUMPTION",
            null
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "approvedCommit"
          ],
          "properties": {
            "approvedCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        {
          "required": [
            "commitPolicy"
          ],
          "properties": {
            "commitPolicy": {
              "const": "SELF_COMMIT_RESOLVED_AT_CONSUMPTION"
            }
          }
        }
      ]
    },
    "authorityRole": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "object"
    },
    "runtimeBindings": {
      "type": "object",
      "required": [
        "persistentExecution",
        "deviceExecution"
      ],
      "properties": {
        "persistentExecution": {
          "type": "string"
        },
        "deviceExecution": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "veritasRequired",
        "receiptRequired"
      ],
      "properties": {
        "veritasRequired": {
          "type": "boolean"
        },
        "receiptRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
